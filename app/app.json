{
  "expo": {
    "name": "vigvita-app",
    "slug": "vigvita-app",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/AppIcon.png",
    "scheme": "vigvitaapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/AppIcon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "isTabletOnly": true,
      "bundleIdentifier": "com.vigvita.vigadn",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.vigvita.vigadn",
      "adaptiveIcon": {
        "foregroundImage": "./assets/AppIcon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/AppIcon.png"
    },
    "plugins": [
      "expo-router",
      "./withTabletOnly.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ded09d85-e2c3-4bff-b674-fe2b3a488d21"
      }
    }
  }
}
